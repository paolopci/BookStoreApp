        </div> *@

        <div class="mb-3">
            <label for="bio" class="form-label">Bio</label>
            <InputTextArea id="bio" class="form-control" @bind-Value="Author.Bio" />
            <ValidationMessage For="@(() => Author.Bio)" />
        </div>
    </fieldset>


    <button type="submit" class="btn btn-primary" @onclick="GoToEdit"><span class="oi oi-pencil me-2" aria-hidden="true"></span>Edit Author</button>
    <button type="button" class="btn btn-secondary ms-2" @onclick="GoBack">Back To List</button>
</EditForm>

