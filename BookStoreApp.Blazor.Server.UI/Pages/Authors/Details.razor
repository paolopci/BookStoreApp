@code {
    [Parameter] public int Id { get; set; }

    private AuthorReadOnlyDto Author = new();

    protected async override Task OnInitializedAsync()
    {
        try
        {
            var response = await authorService.GetAuthorByIdAsync(Id);
            if (response.Success)
            {
                Author = response.Data;
            }
            else
            {
                // Handle error, e.g., show a message or redirect
                NavigationManager.NavigateTo("/authors");
            }
        }
        catch (Exception ex)
        {
            // Log the exception and handle it accordingly
            Console.Error.WriteLine($"Error fetching author details: {ex.Message}");
            NavigationManager.NavigateTo("/authors");
        }
    }


    private void GoBack()
    {
        NavigationManager.NavigateTo("/authors");
    }

    private void GoToEdit()
    {
        NavigationManager.NavigateTo($"/authors/update/{Id:int}");
    }

}
