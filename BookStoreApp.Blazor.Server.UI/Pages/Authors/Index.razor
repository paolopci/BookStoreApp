@page "/authors/"
@inject IAuthorService authorService
@inject IJSRuntime js
<h3>Authors List</h3>


@if (response.Success == false)
{
    <div class="alert alert-danger">
        <h4>@response.Message</h4>
    </div>
}
else
{
    @if (Authors == null)
    {
        <div class="d-flex justify-content-center align-items-center" style="height: 200px;">
            <img src="images/Thinarrows.gif" alt="Loading Data..." />
        </div>
    }
    else
    {
        <a class="btn btn-dark" href="/authors/create">
            <span class="oi oi-plus" aria-hidden="true"></span>
            Create
        </a>
        <br />
        <table class="table table-responsive">
            <thead>
                <tr>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Authors)
                {
                    <tr>
                        <td>@item.FirstName</td>
                        <td>@item.LastName</td>
                        <td>
                            <a class="btn btn-primary" href="@($"/authors/details/{item.Id}")"> <span class="oi oi-book" aria-hidden="true"></span> Details</a>
                            <a class="btn btn-warning" href="@($"/authors/update/{item.Id}")"> <span class="oi oi-pencil" aria-hidden="true"></span> Edit</a>
                            <a class="btn btn-danger" @onclick=@(()=>Delete(item.Id))> <span class="oi oi-delete" aria-hidden="true"></span> Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

}


@code {

    private List<AuthorReadOnlyDto>? Authors;

    private Response<List<AuthorReadOnlyDto>> response = new Response<List<AuthorReadOnlyDto>>() { Success = true };


    protected override async Task OnInitializedAsync()
    {
        response = await authorService.GetAllAuthors();
        if (response.Success)
        {
            Authors = response.Data;
        }

    }
    private async Task Delete(int authorId)
    {
        var author = Authors?.First(a => a.Id == authorId);
        var confirm = await js.InvokeAsync<bool>($"confirm", $"Are you sure you want to delete this author {author.FirstName} {author.LastName}?");
        await authorService.AuthorDeleteAsync(authorId);
        if (confirm)
        {
            Authors = Authors?.Where(a => a.Id != authorId).ToList();
            response.Message = "Author deleted successfully.";
        }
    }
}
