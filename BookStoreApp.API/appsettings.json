{
  // Specifies which hosts are allowed to access the application.
  "AllowedHosts": "*",

  // Serilog configuration section for structured logging.
  "Serilog": {
    // Sets the minimum log level for different sources.
    "MinimumLevel": {
      // Default minimum log level for all log events.
      "Default": "Information",
      // Overrides for specific sources.
      "Override": {
        // Sets Microsoft logs to Warning level.
        "Microsoft": "Warning",
        // Sets Microsoft.Hosting.Lifetime logs to Information level.
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    // Specifies the destinations (sinks) where Serilog writes log events.
    "WriteTo": [
      {
        // Writes log events to a file.
        "Name": "File",
        "Args": {
          // The path pattern for log files. Log files are stored in the 'logs' directory with a date suffix.
          "path": "./logs/log-.txt",
          // Creates a new log file each day (daily log rotation).
          "rollingInterval": "Day"
        }
      },
      {
        // Writes log events to the console.
        "Name": "Console",
        "Args": {
          // Optional: Specifies the output template for console logs.
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level}] {Message}{NewLine}{Exception}"
        }
      },
      {
        // Writes log events to a Seq server for centralized log management.
        "Name": "Seq",
        "Args": {
          // The URL of the Seq server.
          "serverUrl": "http://localhost:5341"
        }
      }
    ]
  },
  "ConnectionStrings": {
    // Connection string for the SQL Server database.
    "BookStoreAppDbConnection": "Server=DESKTOP-BEQ2HPD\\SQLEXPRESS;Database=BookStoreDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "JwtSettings": {
    "Issuer": "BookStoreAPI", // Rappresenta il soggetto che ha emesso il token.
    "Audience": "BookStoreApiClient", // Rappresenta il destinatario del token.
    "Duration": 10 // Token expiration time in minutes
  }

}
