{

  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    // Specifies the destinations (sinks) where Serilog writes log events.
    "WriteTo": [
      {
        // Writes log events to a file.
        "Name": "File",
        "Args": {
          // The path pattern for log files. Log files are stored in the 'logs' directory with a date suffix.
          "path": "./logs/log-.txt",
          // Creates a new log file each day (daily log rotation).
          "rollingInterval": "Day"
        }
      },
      {
        // Writes log events to the console.
        "Name": "Console",
        "Args": {
          // Optional: Specifies the output template for console logs.
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level}] {Message}{NewLine}{Exception}"
        }
      }
    ]
  }
}
